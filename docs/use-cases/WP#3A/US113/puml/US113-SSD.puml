@startuml US113-SSD
autonumber
actor "ATCC / BO" as Actor
participant "AISafe System" as System

activate Actor

group View Route by ID
    Actor -> System: GET /api/flight-routes/{id}
    activate System
    alt route exists
        System --> Actor: 200 OK (Route Details + HATEOAS links)
    else route not found
        System --> Actor: 404 Not Found
    end
    deactivate System
end

group View Routes by Origin Airport
    Actor -> System: GET /api/flight-routes?originIata={iata}&page={p}&size={s}
    activate System
    System --> Actor: 200 OK (Paginated Route List + HATEOAS links)
    deactivate System
end

deactivate Actor
@enduml