    {
      "name": "4. TEST PUT - Correct Update",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200 OK after Update\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Distance was updated successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.distance).to.eql(300.0);",
              "    pm.expect(jsonData.estimatedFlightTime).to.eql(50);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set(\"routeVersion\", jsonData.version);",
              "    console.log(\"Nova versão guardada: \" + jsonData.version);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
