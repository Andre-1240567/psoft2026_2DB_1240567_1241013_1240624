{
  "info": {
    "_postman_id": "c1a2b3c4-d5e6-7f8g-9h0i-j1k2l3m4n5o6",
    "name": "WP#1A - Aircraft Management",
    "description": "Endpoints for Work Package 1A (US101 to US105), including JWT Authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Get JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "if(jsonData.token) {",
                  "    pm.environment.set(\"jwt_token\", jsonData.token);",
                  "    pm.environment.set(\"aircraftReg\", \"PT-XYZ\");",
                  "    console.log(\"Token saved!\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin\", \"password\": \"admin123\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "US101 - Register Aircraft Model",
      "item": [
        {
          "name": "Create Aircraft Model",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"manufacturer\": \"AIRBUS\",\n    \"modelName\": \"A321neo\",\n    \"seatingCapacity\": 244,\n    \"fuelCapacity\": 32940,\n    \"maxRange\": 7400,\n    \"cruisingSpeed\": 833\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/aircraft-models",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "aircraft-models"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response contains model name\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.modelName).to.eql(\"A321neo\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "US102 - Register Aircraft Instance",
      "item": [
        {
          "name": "Create Aircraft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"registrationNumber\": \"PT-XYZ\",\n    \"modelName\": \"A321neo\",\n    \"manufacturingDate\": \"2024-05-20\",\n    \"activeConfigurationName\": \"Economy\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/aircrafts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "aircrafts"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response contains HATEOAS _links\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"_links\");",
                  "});",
                  "pm.test(\"Registration number is correct\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.registrationNumber).to.eql(\"PT-XYZ\");",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"aircraftVersion\", jsonData.version);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "US103 - View Aircraft Details",
      "item": [
        {
          "name": "Get Aircraft by Registration",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/aircrafts/PT-XYZ",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "aircrafts",
                "PT-XYZ"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response contains HATEOAS _links\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"_links\");",
                  "});",
                  "pm.test(\"Aircraft status is AVAILABLE\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"AVAILABLE\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "US104 - Search Aircraft",
      "item": [
        {
          "name": "Search Aircrafts (With Filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/aircrafts?status=AVAILABLE&year=2024",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "aircrafts"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "AVAILABLE"
                },
                {
                  "key": "year",
                  "value": "2024"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returns a list\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "US105 - Update Operational Status",
      "item": [
        {
          "name": "Patch Aircraft Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"IN_FLIGHT\", \"version\": {{aircraftVersion}}}"
            },
            "url": {
              "raw": "{{base_url}}/api/aircrafts/PT-XYZ/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "aircrafts",
                "PT-XYZ",
                "status"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Aircraft status updated to IN_FLIGHT\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"IN_FLIGHT\");",
                  "});",
                  "pm.test(\"Response contains HATEOAS _links\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"_links\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
