      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Certification added\", function () {",
              "    var jsonData = pm.response.json();",
              "    var certs = jsonData.certifications;",
              "    pm.expect(certs).to.be.an(\"array\");",
              "    var found = certs.some(function(c) { return c === \"737 MAX\"; });",
              "    pm.expect(found).to.be.true;",
              "});"
