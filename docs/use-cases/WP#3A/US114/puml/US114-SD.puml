@startuml
autonumber
actor "ATCC" as Actor
participant ":FlightRouteController" as Ctrl
participant ":FlightRouteService" as Service
participant "routeRepository\n:FlightRouteRepository" as Repo

activate Actor
Actor -> Ctrl: GET /api/flight-routes?originIata={iata}&destinationIata={iata}
activate Ctrl

Ctrl -> Service: searchRoutes(originIata, destinationIata, pageable)
activate Service

note right of Service: IATA codes uppercased\nbefore querying

alt originIata != null && destinationIata != null
    Service -> Repo: findByOrigin_IataCode_CodeAndDestination_IataCode_Code(origin, dest, pageable)
    activate Repo
    Repo --> Service: Page<FlightRoute>
    deactivate Repo
else originIata != null
    Service -> Repo: findByOrigin_IataCode_Code(origin, pageable)
    activate Repo
    Repo --> Service: Page<FlightRoute>
    deactivate Repo
else destinationIata != null
    Service -> Repo: findByDestination_IataCode_Code(dest, pageable)
    activate Repo
    Repo --> Service: Page<FlightRoute>
    deactivate Repo
else neither provided
    Service -> Repo: findAll(pageable)
    activate Repo
    Repo --> Service: Page<FlightRoute>
    deactivate Repo
end

note right of Service: resultPage.map(FlightRouteResponseDTO::new)\nexecuted inside @Transactional boundary

Service --> Ctrl: Page<FlightRouteResponseDTO>
deactivate Service

Ctrl --> Actor: 200 OK (PagedModel<EntityModel<FlightRouteResponseDTO>>)
deactivate Ctrl
deactivate Actor
@enduml