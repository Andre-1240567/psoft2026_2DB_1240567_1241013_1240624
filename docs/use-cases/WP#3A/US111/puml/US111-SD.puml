@startuml
autonumber
actor "ATCC" as ATCC
participant ":FlightRouteController" as Ctrl
participant ":FlightRouteService" as Service
participant "routeRepository\n:FlightRouteRepository" as Repo
participant "route\n:FlightRoute" as Route

activate ATCC
ATCC -> Ctrl: GET /api/flight-routes/{id}/history
activate Ctrl

Ctrl -> Service: getRouteHistory(routeId)
activate Service

Service -> Repo: findByIdWithHistory(routeId)
activate Repo
note right of Repo: LEFT JOIN FETCH r.history\navoids LazyInitializationException
Repo --> Service: Optional<FlightRoute>
deactivate Repo

note right of Service: throws ResourceNotFoundException (404)\nif route not found

Service -> Route: getHistory()
activate Route
Route --> Service: List<RouteHistory>
deactivate Route

Service --> Ctrl: List<RouteHistoryDTO>
deactivate Service

Ctrl --> ATCC: 200 OK (List<RouteHistoryDTO>)
deactivate Ctrl
deactivate ATCC

@enduml