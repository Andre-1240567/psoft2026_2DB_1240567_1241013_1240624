        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/flight-routes?status=ACTIVE&sortBy=popularity&page=0&size=10",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "flight-routes" ],
          "query": [
            { "key": "status", "value": "ACTIVE" },
            { "key": "sortBy", "value": "popularity" },
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" }
          ]
        }
