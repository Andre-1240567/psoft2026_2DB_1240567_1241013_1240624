@startuml
autonumber
actor "ATCC" as Actor
participant ":FlightRouteController" as Ctrl
participant ":FlightRouteService" as Service
participant "routeRepository\n:FlightRouteRepository" as Repo

activate Actor

group Get route by ID
Actor -> Ctrl: GET /api/flight-routes/{id}
activate Ctrl

Ctrl -> Service: getRouteById(id)
activate Service

Service -> Repo: findByIdWithHistory(routeId)
activate Repo
note right of Repo: LEFT JOIN FETCH r.history\nloads history in one query
Repo --> Service: Optional<FlightRoute>
deactivate Repo

note right of Service: throws ResourceNotFoundException (404)\nif not found

Service --> Ctrl: FlightRouteResponseDTO
deactivate Service

Ctrl --> Actor: 200 OK (FlightRouteResponseDTO)
deactivate Ctrl
end

group Search routes from a specific airport
Actor -> Ctrl: GET /api/flight-routes?originIata=XXX&page=0&size=10
activate Ctrl

Ctrl -> Service: searchRoutes(originIata, null, pageable)
activate Service

Service -> Repo: findByOrigin_IataCode_Code(originIata, pageable)
activate Repo
Repo --> Service: Page<FlightRoute>
deactivate Repo

note right of Service: each FlightRoute mapped to\nFlightRouteResponseDTO inside\nthe open @Transactional boundary

Service --> Ctrl: Page<FlightRouteResponseDTO>
deactivate Service

Ctrl --> Actor: 200 OK (PagedModel<EntityModel<FlightRouteResponseDTO>>)
deactivate Ctrl
end

deactivate Actor
@enduml