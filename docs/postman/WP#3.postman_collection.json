  "item": [
    {
      "name": "0. AUTH - Login as ATCC",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set(\"jwt_token\", jsonData.token);",
              "    console.log(\"JWT Token saved!\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"atcc\",\n    \"password\": \"atcc123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "auth", "login" ]
        }
      }
    },
    {
      "name": "1. [WP3A] US110 - Create Flight Route (OPO-MAD)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains HATEOAS _links\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('_links');",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set(\"routeId\", jsonData.routeId);",
              "    pm.environment.set(\"routeVersion\", jsonData.version);",
              "    console.log(\"ID da rota guardado: \" + jsonData.routeId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [ { "key": "token", "value": "{{jwt_token}}", "type": "string" } ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"originIata\": \"OPO\",\n    \"destinationIata\": \"MAD\",\n    \"distance\": 420.5,\n    \"estimatedFlightTime\": 70,\n    \"minRangeRequired\": 500.0,\n    \"minCapacityRequired\": 100\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/flight-routes",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "flight-routes" ]
        }
      }
    },
    {
      "name": "2. [WP3A] US112 - Update Flight Route",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200 OK after Update\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Distance was updated successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.distance).to.eql(450.0);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set(\"routeVersion\", jsonData.version);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [ { "key": "token", "value": "{{jwt_token}}", "type": "string" } ]
        },
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"distance\": 450.0,\n    \"estimatedFlightTime\": 75,\n    \"minRangeRequired\": 550.0,\n    \"minCapacityRequired\": 120,\n    \"version\": {{routeVersion}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/flight-routes/{{routeId}}",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "flight-routes", "{{routeId}}" ]
        }
      }
    },
