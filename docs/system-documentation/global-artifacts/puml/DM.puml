@startuml DM
title Domain Model - AISafe (Phase 0 - Full Integration)

skinparam classAttributeIconSize 0
hide circle
hide methods

left to right direction

' --- SHARED VALUE OBJECTS ---
class OperationalStatus <<Value Object>> {
    - status
}

class SeatConfiguration <<Value Object>> {
    - configurationName
    - capacity
}

' --- AGGREGATE: AIRCRAFT MODEL ---
package "Aircraft Model Aggregate" <<Rectangle>> {
    class AircraftModel <<Aggregate Root>> <<Entity>> {
        - manufacturer : String
        - modelName : String
        - fuelCapacity : Double
        - maxRange : Double
        - cruisingSpeed : Double
        - seatingCapacity : Int
    }

    class AircraftFeature <<Value Object>> {
        - featureDescription : String
    }

    AircraftModel "1" *-- "1..*" SeatConfiguration : has >
    AircraftModel "1" *-- "0..*" AircraftFeature : possesses >
}

' --- AGGREGATE: AIRCRAFT ---
package "Aircraft Aggregate" <<Rectangle>> {
    class Aircraft <<Aggregate Root>> <<Entity>> {
        - registrationNumber : Int
        - manufacturingDate : Date
    }

    Aircraft "1" *-- "1" OperationalStatus : has >
}

' --- AGGREGATE: AIRPORT ---
package "Airport Aggregate" <<Rectangle>> {
    class Airport <<Aggregate Root>> <<Entity>> {
        - name : String
        - timezone : String
    }

    class IATACode <<Value Object>> {
        - code : Int
    }

    class Location <<Value Object>> {
        - region : String
        - country : String
        - city : String
        - coordinates : fazer value object
    }

    class OperationalHours <<Value Object>> {
        - openingTime : LocalTime
        - closingTime : LocalTime
        - notes : String
    }

    class Contact <<Value Object>> {
        - type (phone, email, fax, etc.) : String
        - value : Int
        - departmentOrDescription : String
    }

    class Runway <<Entity>> {
        - name : String
        - length : Double
        - orientation : String
    }

    class AirplaneCertification <<Value Object>> {
        - certificationDate : Date
    }

    class Terminal <<Entity>> {
        - name : String
    }

    class Gate <<Entity>> {
        - gateNumber : Int
    }

    class FacilityService <<Value Object>> {
        - name : String
        - type : String
    }

    Airport "1" *-- "1" IATACode : identified by >
    Airport "1" *-- "1" Location : located at >
    Airport "1" *-- "1" OperationalHours : operates during >
    Airport "1" *-- "1..*" Contact : reached via >
    Airport "1" *-- "1..*" Runway : has >
    Airport "1" *-- "0..*" AirplaneCertification : grants >
    Airport "1" *-- "1" OperationalStatus : has >
    Airport "1" *-- "0..*" Terminal : has >
    Terminal "1" *-- "1..*" Gate : contains >
    Airport "1" *-- "0..*" FacilityService : provides >
}

' --- AGGREGATE: FLIGHT ROUTE ---
package "Flight Route Aggregate" <<Rectangle>> {
    class FlightRoute <<Aggregate Root>> <<Entity>> {
        - routeId : Int
        - distance : Double
        - estimatedFlightTime : Duration
        - routeStatus : String
    }

    class RouteRequirement <<Value Object>> {
        - minRangeRequired : Double
        - minCapacityRequired : Int
    }

    class RouteHistory <<Value Object>> {
        - changeDate : Date
        - description : String
    }

    FlightRoute "1" *-- "1" RouteRequirement : defined by >
    FlightRoute "1" *-- "0..*" RouteHistory : tracked by >
}

' --- AGGREGATE: SCHEDULED FLIGHT ---
package "Scheduled Flight Aggregate" <<Rectangle>> {
    class ScheduledFlight <<Aggregate Root>> <<Entity>> {
        - flightNumber : Int
        - scheduledDateTime : Date
    }

    class FlightStatus <<Value Object>> {
        - status : String
    }

    ScheduledFlight "1" *-- "1" FlightStatus : has >
}

' --- EXTERNAL RELATIONS (BETWEEN AGGREGATES) ---
Aircraft "0..*" --> "1" AircraftModel : is instance of >
Aircraft "0..*" --> "1" SeatConfiguration : configured with >
AirplaneCertification "0..*" --> "1" AircraftModel : authorizes >

ScheduledFlight "0..*" --> "1" FlightRoute : follows >
ScheduledFlight "0..*" --> "1" Aircraft : assigned to >

FlightRoute "0..*" --> "1" Airport : origin >
FlightRoute "0..*" --> "1" Airport : destination >

@enduml