@startuml US112-CD
skinparam classAttributeIconSize 0

package "api" {
    class FlightRouteController {
        + updateRoute(id: String, dto: UpdateFlightRouteDTO): ResponseEntity<FlightRouteResponseDTO>
        + deactivateRoute(id: String): ResponseEntity<FlightRouteResponseDTO>
    }
    class UpdateFlightRouteDTO {
        - distance: Double
        - estimatedFlightTime: Integer
        - minRangeRequired: Double
        - minCapacityRequired: Integer
        - version: Long
    }
    class FlightRouteResponseDTO
    class FlightRouteModelAssembler {
        + toModel(entity: FlightRoute): FlightRouteResponseDTO
    }
}

package "services" {
    class FlightRouteService {
        + updateRoute(id: String, dto: UpdateFlightRouteDTO): FlightRoute
        + deactivateRoute(id: String): FlightRoute
    }
}

package "repositories" {
    interface FlightRouteRepository {
        + findById(id: String): Optional<FlightRoute>
        + save(route: FlightRoute): FlightRoute
    }
}

package "domain" {
    class FlightRoute <<Aggregate Root>> <<Entity>> {
        - version: Long
        + updateDetails(distance: Double, estimatedFlightTime: Integer, req: RouteRequirement, author: String)
        + deactivate(author: String)
        + getVersion(): Long
    }
    class RouteId <<Value Object>>
    class RouteRequirement <<Value Object>>
    class RouteHistory <<Value Object>>
    enum RouteStatus <<Enum>> {
        ACTIVE
        DEACTIVATED
    }
}

FlightRouteController ..> UpdateFlightRouteDTO
FlightRouteController ..> FlightRouteResponseDTO
FlightRouteController --> FlightRouteService : delegates to
FlightRouteController --> FlightRouteModelAssembler : uses
FlightRouteModelAssembler ..> FlightRouteResponseDTO : produces
FlightRouteService --> FlightRouteRepository : uses
FlightRouteService ..> FlightRoute : updates
FlightRoute "1" *-- "1" RouteId : identified by >
FlightRoute "1" *-- "1" RouteRequirement : defined by >
FlightRoute "1" *-- "0..*" RouteHistory : tracked by >
FlightRoute "1" *-- "1" RouteStatus : current status >

@enduml