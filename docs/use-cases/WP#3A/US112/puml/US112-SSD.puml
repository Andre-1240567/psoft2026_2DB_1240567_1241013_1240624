@startuml US112-SSD
autonumber
actor "ATCC / BO" as Actor
participant "AISafe System" as System

activate Actor

alt Update Flight Route
    Actor -> System: PUT /api/flight-routes/{id} (distance, requirements, version)
    activate System
    alt version mismatch or route deactivated
        System --> Actor: 409 Conflict
    else success
        System --> Actor: 200 OK (Updated Route + HATEOAS links)
    end
    deactivate System

else Deactivate Flight Route
    Actor -> System: PATCH /api/flight-routes/{id}/deactivate
    activate System
    alt route already deactivated
        System --> Actor: 409 Conflict
    else success
        System --> Actor: 200 OK (Deactivated Route + HATEOAS links)
    end
    deactivate System
end

deactivate Actor
@enduml