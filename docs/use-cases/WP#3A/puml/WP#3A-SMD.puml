@startuml
hide empty description

[*] --> ACTIVE : US110: Route Created\n[Constraints Validated]

state ACTIVE {
  ACTIVE : The flight route is operational.
  ACTIVE : Distance and requirements can be updated.
}

state DEACTIVATED {
  DEACTIVATED : The flight route is locked.
  DEACTIVATED : Mutating operations are blocked.
  DEACTIVATED : Preserved for historical auditing.
}

ACTIVE --> ACTIVE : US112: Update Route\n[Optimistic Lock Valid]
ACTIVE --> DEACTIVATED : US112: Deactivate Route\n[Action requested]

DEACTIVATED --> [*] : End of mutating lifecycle

note right of ACTIVE
  Every state transition implicitly
  triggers US111 (Track Route History)
end note

@enduml