@startuml US111-CD
skinparam classAttributeIconSize 0

package "api" {
    class FlightRouteController {
        + getRouteHistory(routeId: String): ResponseEntity<List<RouteHistoryDTO>>
    }
    class RouteHistoryDTO {
        - changeDate: LocalDateTime
        - description: String
        - author: String
    }
}

package "services" {
    class FlightRouteService {
        + getRouteHistory(routeId: String): List<RouteHistory>
    }
}

package "repositories" {
    interface FlightRouteRepository {
        + findByIdWithHistory(routeId: String): Optional<FlightRoute>
    }
}

package "domain" {
    class FlightRoute <<Aggregate Root>> <<Entity>> {
        - version: Long
        + getHistory(): List<RouteHistory>
        + addHistory(description: String, author: String)
    }

    class RouteId <<Value Object>> {
        - id: String
    }

    class RouteHistory <<Value Object>> {
        - changeDate: LocalDateTime
        - description: String
        - author: String
        + RouteHistory(description: String, author: String)
    }
}

FlightRouteController ..> RouteHistoryDTO
FlightRouteController --> FlightRouteService : delegates to
FlightRouteService --> FlightRouteRepository : uses
FlightRouteService ..> FlightRoute : retrieves
FlightRoute "1" *-- "1" RouteId : identified by >
FlightRoute "1" *-- "0..*" RouteHistory : tracks >

@enduml