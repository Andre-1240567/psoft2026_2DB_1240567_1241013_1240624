@startuml
skinparam classAttributeIconSize 0

package "pt.isep.psoft.alsafe.flightroutes.api" {
    class FlightRouteController {
        + searchRoutes(originIata, destinationIata, page, size, assembler): ResponseEntity<PagedModel>
    }
    class FlightRouteResponseDTO {
        - routeId: String
        - originIataCode: String
        - destinationIataCode: String
        - distance: Double
        - estimatedFlightTime: Integer
        - minRangeRequired: Double
        - minCapacityRequired: Integer
        - routeStatus: RouteStatus
        - version: Long
        - history: List<RouteHistoryDTO>
    }
}

package "pt.isep.psoft.alsafe.flightroutes.services" {
    class FlightRouteService {
        + searchRoutes(originIata, destinationIata, pageable): Page<FlightRouteResponseDTO>
    }
}

package "pt.isep.psoft.alsafe.flightroutes.repositories" {
    interface FlightRouteRepository {
        + findByOrigin_IataCode_Code(origin, pageable): Page<FlightRoute>
        + findByDestination_IataCode_Code(dest, pageable): Page<FlightRoute>
        + findByOrigin_IataCode_CodeAndDestination_IataCode_Code(origin, dest, pageable): Page<FlightRoute>
        + findAll(pageable): Page<FlightRoute>
    }
}

FlightRouteController --> FlightRouteService : uses
FlightRouteService --> FlightRouteRepository : uses
FlightRouteService ..> FlightRouteResponseDTO : creates
FlightRouteController ..> FlightRouteResponseDTO : returns

@enduml