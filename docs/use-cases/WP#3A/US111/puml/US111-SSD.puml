@startuml US111-SSD
autonumber
actor "ATCC" as ATCC
participant "AISafe System" as System

activate ATCC
ATCC -> System: GET /api/flight-routes/{routeId}/history
activate System

alt Route exists
    System --> ATCC: 200 OK (List of RouteHistory entries + HATEOAS links)
else Route not found
    System --> ATCC: 404 Not Found
end

deactivate System
deactivate ATCC
@enduml