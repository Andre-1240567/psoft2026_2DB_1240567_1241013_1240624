@startuml US215-SSD

actor "ATCC" as ATCC
participant "AISafe System" as System

ATCC -> System : GET /api/flight-routes/network/total-distance

alt missing or invalid JWT
    System --> ATCC : 401 Unauthorized
else insufficient role (not ATCC)
    System --> ATCC : 403 Forbidden
else valid request
    System --> ATCC : 200 OK\n{ "totalDistance": 12500.5 }
end

@enduml