  "item": [
    {
      "name": "TEST POST - Correct",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. O status HTTP tem de ser 201 (Created)\r",
              "pm.test(\"Status is 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// 2. Garantir que a resposta tem a estrutura correta (HATEOAS)\r",
              "pm.test(\"Response contains _links and data\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('data');\r",
              "    pm.expect(jsonData).to.have.property('_links');\r",
              "});\r",
              "\r",
              "// 3. MAGIA: Guardar o ID e a Versão criados para usar nos próximos testes!\r",
              "if (pm.response.code === 201) {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.environment.set(\"routeId\", jsonData.data.routeId);\r",
              "    pm.environment.set(\"routeVersion\", jsonData.data.version);\r",
              "    console.log(\"ID da rota guardado: \" + jsonData.data.routeId);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"originIata\": \"OPO\",\r\n    \"destinationIata\": \"LIS\",\r\n    \"distance\": 280.5,\r\n    \"estimatedFlightTime\": 45,\r\n    \"minRangeRequired\": 350.0,\r\n    \"minCapacityRequired\": 100\r\n}",
