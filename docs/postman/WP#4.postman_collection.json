    {
      "name": "US115A - Maintenance Templates",
      "item": [
        {
          "name": "1. TEST POST - Create Template (Correct)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response contains HATEOAS _links\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property('_links');",
                  "});",
                  "pm.test(\"Template has correct name\", function () {",
                  "    pm.expect(pm.response.json().templateName).to.eql(\"Engine Inspection A\");",
                  "});",
                  "pm.test(\"Checklist has 3 items\", function () {",
                  "    pm.expect(pm.response.json().checklist).to.have.lengthOf(3);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set(\"templateId\", json.id);",
                  "    pm.environment.set(\"templateVersion\", json.version);",
                  "    console.log(\"Template ID saved: \" + json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
