              "    pm.response.to.have.status(400);\r",
              "});\r",
              "\r",
              "// 2. Garantir que a mensagem de erro é a correta\r",
              "pm.test(\"Error message is correct\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.erro).to.eql(\"A origem e o destino não podem ser o mesmo aeroporto.\");\r",
              "});"
