@startuml US112-SD
autonumber
actor "ATCC / BO" as Actor
participant "FlightRouteController" as Ctrl
participant "FlightRouteService" as Service
participant "FlightRouteRepository" as Repo
participant "route\n:FlightRoute" as Route
participant "req\n:RouteRequirement" as Req
participant "FlightRouteModelAssembler" as Assembler

activate Actor

group Update flow
    Actor -> Ctrl: PUT /api/flight-routes/{id} (UpdateFlightRouteDTO)
    activate Ctrl

    Ctrl -> Service: updateRoute(id, dto)
    activate Service

    Service -> Repo: findById(id)
    activate Repo
    Repo --> Service: Optional<FlightRoute>
    deactivate Repo
    note right of Service: throws ResourceNotFoundException (404)\nif not found

    Service -> Service: validate version\n(dto.version == route.version)
    note right of Service: throws ObjectOptimisticLockingFailureException (409)\nif versions do not match

    Service -> Req**: create(dto.minRangeRequired, dto.minCapacityRequired)

    Service -> Route: updateDetails(dto.distance, dto.estimatedFlightTime, req, author)
    activate Route
    note right of Route: guards against DEACTIVATED status (409)\nappends history entry internally
    deactivate Route

    Service -> Repo: save(route)
    activate Repo
    Repo --> Service: savedRoute
    deactivate Repo

    Service --> Ctrl: savedRoute
    deactivate Service
    
    Ctrl -> Assembler: toModel(savedRoute)
    activate Assembler
    Assembler --> Ctrl: FlightRouteResponseDTO\n(with _links)
    deactivate Assembler

    Ctrl --> Actor: 200 OK (FlightRouteResponseDTO)
    deactivate Ctrl
end

group Deactivate flow
    Actor -> Ctrl: PATCH /api/flight-routes/{id}/deactivate
    activate Ctrl

    Ctrl -> Service: deactivateRoute(id)
    activate Service

    Service -> Repo: findById(id)
    activate Repo
    Repo --> Service: Optional<FlightRoute>
    deactivate Repo
    note right of Service: throws ResourceNotFoundException (404)\nif not found

    Service -> Route: deactivate(author)
    activate Route
    note right of Route: guards against already DEACTIVATED (409)\nappends history entry internally
    deactivate Route

    Service -> Repo: save(route)
    activate Repo
    Repo --> Service: savedRoute
    deactivate Repo

    Service --> Ctrl: savedRoute
    deactivate Service
    
    Ctrl -> Assembler: toModel(savedRoute)
    activate Assembler
    Assembler --> Ctrl: FlightRouteResponseDTO\n(with _links)
    deactivate Assembler
    
    Ctrl --> Actor: 200 OK (FlightRouteResponseDTO)
    deactivate Ctrl
end

deactivate Actor
@enduml