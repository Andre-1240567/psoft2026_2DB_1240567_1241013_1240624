@startuml
autonumber
actor "ATCC" as ATCC
participant ":FlightRouteController" as Ctrl
participant ":FlightRouteService" as Service
participant "airportService\n:AirportService" as AirportSvc
participant "routeRepository\n:FlightRouteRepository" as RepoRoute
participant "origin\n:Airport" as Origin
participant "destination\n:Airport" as Dest
participant "req\n:RouteRequirement" as Req
participant "route\n:FlightRoute" as Route

activate ATCC
ATCC -> Ctrl: POST /api/flight-routes (CreateFlightRouteDTO)
activate Ctrl

Ctrl -> Service: createFlightRoute(dto)
activate Service

Service -> AirportSvc: getAirportDetails(dto.originIata)
activate AirportSvc
AirportSvc --> Service: origin
deactivate AirportSvc

Service -> Origin: getStatus()
activate Origin
Origin --> Service: status
deactivate Origin
note right of Service: throws IllegalArgumentException (400)\nif status != OPERATIONAL

Service -> AirportSvc: getAirportDetails(dto.destinationIata)
activate AirportSvc
AirportSvc --> Service: destination
deactivate AirportSvc

Service -> Dest: getStatus()
activate Dest
Dest --> Service: status
deactivate Dest
note right of Service: throws IllegalArgumentException (400)\nif status != OPERATIONAL

Service -> Req**: create(dto.minRangeRequired, dto.minCapacityRequired)
Service -> Route**: create(id, origin, destination, dto.distance, dto.estimatedFlightTime, req, author)

Service -> RepoRoute: save(route)
activate RepoRoute
RepoRoute --> Service: savedRoute
deactivate RepoRoute

Service --> Ctrl: FlightRouteResponseDTO
deactivate Service

Ctrl --> ATCC: 201 Created (FlightRouteResponseDTO)
deactivate Ctrl
deactivate ATCC
@enduml