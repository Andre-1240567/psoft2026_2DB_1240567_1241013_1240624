    @startuml DM
title Domain Model - AISafe (WP1, WP2, WP3)

skinparam classAttributeIconSize 0
hide circle
hide methods

skinparam nodesep 50
skinparam ranksep 50
skinparam packageStyle rectangle

' --- AGGREGATE: USER (WP#0A) ---
package "User Aggregate" {
    enum Role <<Enum>> {
        ADMIN
        BACKOFFICE_OPERATOR
        ATCC
    }
    class User <<Aggregate Root>> <<Entity>> {
        - username : String
        - passwordHash : String
    }
    User "1" *-- "1" Role : has >
}

' --- AGGREGATE: AIRCRAFT MODEL ---
package "Aircraft Model Aggregate" {
    enum Manufacturer <<Enum>> {
        BOEING
        AIRBUS
        EMBRAER
        COMAC
        ATR
        TEXTRON_AVIATION
        GULFSTREAM_AEROSPACE
        PILATUS_AIRCRAFT
        CIRRUS_AIRCRAFT
        DIAMOND_AIRCRAFT
    }
    class AircraftModel <<Aggregate Root>> <<Entity>> {
        - modelName : String
        - fuelCapacity : Double
        - maxRange : Double
        - cruisingSpeed : Double
        - seatingCapacity : Integer
        - technicalImage : String
    }
    class SeatConfiguration <<Value Object>> {
        - configurationName : String
        - capacity : Integer
    }
    class AircraftFeature <<Value Object>> {
        - featureDescription : String
    }
    AircraftModel "1" *-- "1" Manufacturer : built by >
    AircraftModel "1" *-- "1..*" SeatConfiguration : has >
    AircraftModel "1" *-- "0..*" AircraftFeature : possesses >
}

' --- AGGREGATE: AIRCRAFT ---
package "Aircraft Aggregate" {
    enum AircraftStatus <<Enum>> {
        AVAILABLE
        INACTIVE
        UNDER_MAINTENANCE
        IN_FLIGHT
    }
    class Aircraft <<Aggregate Root>> <<Entity>> {
        - registrationNumber : String
        - manufacturingDate : Date
        - activeConfigurationName : String
        - activeCapacity : Integer
        - version : Long
    }
    Aircraft "1" *-- "1" AircraftStatus : current status >
}

' --- AGGREGATE: AIRPORT ---
package "Airport Aggregate" {
    enum AirportStatus <<Enum>> {
        OPERATIONAL
        CLOSED
        UNDER_MAINTENANCE
    }
    enum ContactType <<Enum>> {
        PHONE
        EMAIL
        FAX
    }
    class Airport <<Aggregate Root>> <<Entity>> {
        - name : String
        - photos : List<String>
    }
    class IATACode <<Value Object>> {
        - code : String
    }
    class Location <<Value Object>> {
        - region : String
        - country : String
        - city : String
    }
    class GPSCoordinates <<Value Object>> {
        - latitude : Double
        - longitude : Double
    }
    class OperationalHours <<Value Object>> {
        - openingTime : LocalTime
        - closingTime : LocalTime
    }
    class Contact <<Value Object>> {
        - value : String
        - department : String
    }
    class Runway <<Value Object>> {
        - name : String
        - length : Double
    }
    class AirplaneCertification <<Value Object>> {
        - modelName : String
        - certificationDate : Date
    }
    class Terminal <<Entity>> {
        - designation : String
    }
    class Gate <<Value Object>> {
        - designation : String
    }
    class FacilityService <<Value Object>> {
        - serviceType : String
        - description : String
    }
    class Orientation <<Enum>> {
        N
        S
        E
        W
        NW
        NE
        SW
        SE
    }
    class Timezone <<Value Object>> {
        - offsetValue : String
    }

    Airport "1" *-- "1" IATACode : identified by >
    Airport "1" *-- "1" Location : located at >
    Location "1" *-- "1" GPSCoordinates : defined by >
    Airport "1" *-- "1" OperationalHours : operates during >
    Airport "1" *-- "1..*" Contact : reached via >
    Contact "1" *-- "1" ContactType : is of type >
    Airport "1" *-- "1..*" Runway : has >
    Airport "1" *-- "0..*" AirplaneCertification : grants >
    Airport "1" *-- "1" AirportStatus : has >
    Airport "1" *-- "0..*" Terminal : has >
    Terminal "1" *-- "1..*" Gate : contains >
    Terminal "1" *-- "0..*" FacilityService : provides >
    Runway "1" *-- "1" Orientation : points >
    Airport "1" *-- "1" Timezone : regulates in >
}

' --- AGGREGATE: FLIGHT ROUTES ---
package "Flight Route Aggregate" {
    enum RouteStatus <<Enum>> {
        ACTIVE
        DEACTIVATED
    }
    class FlightRoute <<Aggregate Root>> <<Entity>> {
        - distance : Double
        - estimatedFlightTime : Integer
        - version : Long
    }
    class RouteId <<Value Object>> {
        - id : String
    }
    class RouteRequirement <<Value Object>> {
        - minRangeRequired : Double
        - minCapacityRequired : Integer
    }
    class RouteHistory <<Value Object>> {
        - changeDate : LocalDateTime
        - description : String
        - author : String
    }

    FlightRoute "1" *-- "1" RouteId : identified by >
    FlightRoute "1" *-- "1" RouteRequirement : defined by >
    FlightRoute "1" *-- "0..*" RouteHistory : tracked by >
    FlightRoute "1" *-- "1" RouteStatus : current status >
}

' --- AGGREGATE: SCHEDULED FLIGHT ---
package "Scheduled Flight Aggregate" {
    enum FlightStatus <<Enum>> {
        SCHEDULED
        COMPLETED
        CANCELED
    }
    class ScheduledFlight <<Aggregate Root>> <<Entity>> {
        - flightNumber : String
        - scheduledDeparture : LocalDateTime
        - scheduledArrival : LocalDateTime
        - version : Long
    }

    ScheduledFlight "1" *-- "1" FlightStatus : current status >
}

' --- EXTERNAL RELATIONS ---
Aircraft "0..*" --> "1" AircraftModel : is instance of >
FlightRoute "0..*" --> "1" Airport : origin >
FlightRoute "0..*" --> "1" Airport : destination >
ScheduledFlight "0..*" --> "1" Aircraft : assigned to >
ScheduledFlight "0..*" --> "1" FlightRoute : scheduled on >
AirplaneCertification "0..*" --> "1" AircraftModel : certifies >

@enduml