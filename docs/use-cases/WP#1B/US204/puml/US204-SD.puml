@startuml US204-SD
autonumber
title Sequence Diagram (SD) - US204: Top 5 Most Utilized Aircraft Models

actor "Backoffice Operator" as BO
participant "AircraftModelController" as CTRL
participant "AircraftModelService" as SRV
participant "AircraftRepository" as REPO

BO -> CTRL : GET /api/aircraft-models/top-utilized?criteria={criteria}
activate CTRL

CTRL -> SRV : getTop5MostUtilizedModels(criteria)
activate SRV

alt criteria == "hours"
    SRV -> REPO : findTop5MostUtilizedAircraftModelsByFlightHours(pageable)
    activate REPO
    REPO --> SRV : List<Object[]> results
    deactivate REPO
else criteria == "assignments"
    SRV -> REPO : findTop5MostUtilizedAircraftModelsByAssignments(pageable)
    activate REPO
    REPO --> SRV : List<Object[]> results
    deactivate REPO
end

SRV --> CTRL : List<TopAircraftModelDTO> topModels
deactivate SRV

CTRL --> BO : 200 OK + JSON(topModels)
deactivate CTRL

@enduml
