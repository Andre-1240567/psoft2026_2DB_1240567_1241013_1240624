    {
      "name": "3. TEST GET - Paginated Search",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Contains Paginated Data (Spring HATEOAS structure)\", function () {",
              "    var jsonData = pm.response.json();",
              "    ",
              "    pm.expect(jsonData).to.have.property('page');",
              "    pm.expect(jsonData.page.size).to.eql(5);",
              "    pm.expect(jsonData.page.number).to.eql(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/flight-routes?originIata=OPO&page=0&size=5",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "flight-routes"
          ],
          "query": [
            {
              "key": "originIata",
              "value": "OPO"
