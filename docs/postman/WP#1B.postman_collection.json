  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Get JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "if(jsonData.token) {",
                  "    pm.environment.set(\"jwt_token\", jsonData.token);",
                  "    console.log(\"Token saved!\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin\", \"password\": \"admin123\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "US201 - Update Aircraft Model Specifications",
      "item": [
        {
          "name": "1. Get Aircraft Models (To find ID and Version)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is an array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/aircraft-models",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "aircraft-models"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Update Aircraft Model (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Verify seating capacity updated\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.seatingCapacity).to.eql(250);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"seatingCapacity\": 250,\n    \"fuelCapacity\": 35000.0,\n    \"maxRange\": 8000.0,\n    \"cruisingSpeed\": 860.0,\n    \"version\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/aircraft-models/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "aircraft-models",
                "1"
              ]
            },
            "description": "Change the ID in the URL to the model you want to update. Set the 'version' in the JSON body to match the current version of the object."
          },
          "response": []
        },
        {
          "name": "3. Update Aircraft Model (Conflict - Optimistic Locking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409 Conflict\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"seatingCapacity\": 250,\n    \"fuelCapacity\": 35000.0,\n    \"maxRange\": 8000.0,\n    \"cruisingSpeed\": 860.0,\n    \"version\": 999\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/aircraft-models/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "aircraft-models",
                "1"
              ]
            },
            "description": "This request sends an intentionally wrong version (999) to verify that Optimistic Locking prevents the update."
          },
          "response": []
        }
      ]
    },
    {
      "name": "US202 - Register Aircraft Model with Image",
      "item": [
        {
          "name": "Create Aircraft Model with Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "//Teste de sucesso",
                  "pm.test(\"Status is 201 Created\", function () { ",
                  "    pm.response.to.have.status(201); ",
                  "});",
                  "",
                  "//Testa apenas se a imagem VEM na resposta ",
                  "pm.test(\"Response contains image\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.image).to.not.be.undefined; ",
                  "});",
                  "",
                  "// C\u00f3digo do Visualizer para renderizar a fotografia",
                  "var template = `",
                  "    <div style=\"padding: 20px; font-family: sans-serif;\">",
                  "        <h3 style=\"color: #333;\">AirCraft Model Photo</h3>",
                  "        <img src=\"{{imagePath}}\" style=\"max-width: 600px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);\" />\",",
                  "    </div>",
                  "`;",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.image) {",
                  "    pm.visualizer.set(template, {",
                  "        imagePath: jsonData.image",
                  "    });",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"manufacturer\": \"BOEING\",\n    \"modelName\": \"787 Dreamliner\",\n    \"seatingCapacity\": 300,\n    \"fuelCapacity\": 126000.0,\n    \"maxRange\": 14140.0,\n    \"cruisingSpeed\": 903.0,\n    \"image\": \"http://localhost:8080/images/aircraft-models/787-dreamliner.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/aircraft-models",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "aircraft-models"
              ]
            }
          },
          "response": []
        }
      ]
    },
