@startuml WP#2A-SMD
hide empty description

skinparam state {
    BackgroundColor White
    BorderColor Black
}

' Ponto de entrada
[*] --> OPERATIONAL : US106: Create Airport\n[Data Validated]

' Definição dos Estados
state OPERATIONAL {
  OPERATIONAL : The airport is open and fully functioning.
  OPERATIONAL : Flight routes can be operated.
}

state MAINTENANCE {
  MAINTENANCE : The airport is undergoing maintenance.
  MAINTENANCE : Operations are temporarily restricted.
}

state CLOSED {
  CLOSED : The airport is out of operation.
  CLOSED : Mutating operations related to flights are blocked.
}

' Transições (Todas governadas pela US109)
OPERATIONAL --> MAINTENANCE : US109: Change Status\n[Action requested]
MAINTENANCE --> OPERATIONAL : US109: Change Status\n[Action requested]

OPERATIONAL --> CLOSED : US109: Change Status\n[Action requested]
CLOSED --> OPERATIONAL : US109: Change Status\n[Action requested]

MAINTENANCE --> CLOSED : US109: Change Status\n[Action requested]
CLOSED --> MAINTENANCE : US109: Change Status\n[Action requested]

note right of OPERATIONAL
  State transitions validate if the
  new state is different from the current one.
end note

@enduml