@startuml US111-SD
autonumber
actor "ATCC" as ATCC
participant "FlightRouteController" as Ctrl
participant "FlightRouteService" as Service
participant "FlightRouteRepository" as Repo
participant "route\n:FlightRoute" as Route

activate ATCC
ATCC -> Ctrl: GET /api/flight-routes/{routeId}/history
activate Ctrl

Ctrl -> Service: getRouteHistory(routeId)
activate Service

Service -> Repo: findByIdWithHistory(routeId)
activate Repo
note right of Repo: LEFT JOIN FETCH r.history\navoids LazyInitializationException
Repo --> Service: Optional<FlightRoute>
deactivate Repo

alt route not found
    Service --> Ctrl: throws ResourceNotFoundException
    Ctrl --> ATCC: 404 Not Found
else route exists
    Service -> Route: getHistory()
    activate Route
    Route --> Service: List<RouteHistory>
    deactivate Route

    Service --> Ctrl: List<RouteHistory>
    deactivate Service

    loop for each RouteHistory
        Ctrl -> Ctrl: map to RouteHistoryDTO
    end
    
    Ctrl -> Ctrl: add HATEOAS links to response

    Ctrl --> ATCC: 200 OK (List<RouteHistoryDTO>)
end

deactivate Ctrl
deactivate ATCC

@enduml