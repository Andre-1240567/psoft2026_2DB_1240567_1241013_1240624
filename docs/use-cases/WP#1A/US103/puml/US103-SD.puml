@startuml US103-SD
autonumber
title Sequence Diagram (SD) - US103: View Aircraft Details

actor "ATCC / Backoffice Operator" as Actor
participant ":AircraftController" as Ctrl
participant ":AircraftService" as Service
participant "repository\n:AircraftRepository" as Repo

activate Actor
Actor -> Ctrl: GET /api/aircrafts/{registrationNumber}
activate Ctrl

Ctrl -> Service: getAircraftDetails(registrationNumber)
activate Service

Service -> Repo: findById(registrationNumber)
activate Repo
Repo --> Service: Optional<Aircraft>
deactivate Repo

alt Aircraft Not Found
    Service --> Ctrl: throws ResourceNotFoundException
    Ctrl --> Actor: 404 Not Found
else Aircraft Found
    Service --> Ctrl: aircraft

    note right of Ctrl: Controller maps to DTO\nand adds HATEOAS self-link

    Ctrl --> Actor: 200 OK (AircraftResponseDTO)
end
deactivate Service
deactivate Ctrl
deactivate Actor
@enduml