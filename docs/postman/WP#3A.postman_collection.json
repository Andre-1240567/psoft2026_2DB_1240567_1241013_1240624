          "script": {
            "exec": [
              "pm.test(\"Status is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Contains Paginated Data\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Verifica se a lista de elementos existe\r",
              "    pm.expect(jsonData).to.have.property('content');\r",
              "    \r",
              "    // Verifica se os dados da paginação estão corretos\r",
              "    pm.expect(jsonData.pageable.pageSize).to.eql(5);\r",
              "    pm.expect(jsonData.pageable.pageNumber).to.eql(0);\r",
              "});"
            ],
